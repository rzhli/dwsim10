<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DWSIM.UI.Desktop.Avalonia.ReactionManagerWindow"
        Title="Reactions Manager"
        Width="1000" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <DockPanel Margin="8" LastChildFill="True">

    <Button DockPanel.Dock="Bottom" Name="BtnClose" Classes="dialog"
            Content="Close" Width="80" IsCancel="True"
            HorizontalAlignment="Right" Margin="0,8,0,0" />

    <Grid ColumnDefinitions="*,4,1.4*">

      <!-- ===== Reaction Sets (left) ===== -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Reaction Sets"
                   FontWeight="SemiBold" Margin="2,0,0,4" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
          <Button Name="BtnSetNew"    Classes="panel" Content="New"    MinWidth="60" />
          <Button Name="BtnSetEdit"   Classes="panel" Content="Edit"   MinWidth="60" />
          <Button Name="BtnSetCopy"   Classes="panel" Content="Copy"   MinWidth="60" />
          <Button Name="BtnSetRemove" Classes="panel" Content="Remove" MinWidth="70" />
        </StackPanel>
        <DataGrid Name="GridSets" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  SelectionMode="Single" />
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" />

      <!-- ===== Reactions (right) ===== -->
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Chemical Reactions"
                   FontWeight="SemiBold" Margin="2,0,0,4" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
          <Button Name="BtnRxnAdd"    Classes="panel" Content="Add ▾"  MinWidth="70" />
          <Button Name="BtnRxnEdit"   Classes="panel" Content="Edit"   MinWidth="60" />
          <Button Name="BtnRxnCopy"   Classes="panel" Content="Copy"   MinWidth="60" />
          <Button Name="BtnRxnDelete" Classes="panel" Content="Delete" MinWidth="65" />
          <Button Name="BtnRxnExport" Classes="panel" Content="Export" MinWidth="65" />
          <Button Name="BtnRxnImport" Classes="panel" Content="Import" MinWidth="65" />
        </StackPanel>
        <DataGrid Name="GridReactions" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  SelectionMode="Single" />
      </DockPanel>

    </Grid>

  </DockPanel>

</Window>
