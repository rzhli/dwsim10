<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="DWSIM.UI.Desktop.Avalonia.ScriptEditorWindow"
        x:CompileBindings="False">

  <UserControl.Styles>
    <Style Selector="Button.panel">
      <Setter Property="MinHeight" Value="{DynamicResource ScriptControlHeight}" />
      <Setter Property="Padding" Value="{DynamicResource ScriptControlPadding}" />
    </Style>
    <Style Selector=".scriptToolbar ComboBox, .scriptToolbar TextBox">
      <Setter Property="MinHeight" Value="{DynamicResource ScriptControlHeight}" />
      <Setter Property="Padding" Value="{DynamicResource ScriptControlPadding}" />
    </Style>
    <Style Selector=".scriptToolbar ComboBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=".scriptToolbar TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=".scriptToolbar CheckBox">
      <Setter Property="MinHeight" Value="{DynamicResource ScriptControlHeight}" />
    </Style>
    <Style Selector="ComboBoxItem, ListBox#ScriptList ListBoxItem">
      <Setter Property="MinHeight" Value="{DynamicResource ScriptControlHeight}" />
      <Setter Property="Padding" Value="{DynamicResource ScriptControlPadding}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="6,3">
      <StackPanel Classes="scriptToolbar" Spacing="2">

        <WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,2">
            <Button Name="BtnNew"       Classes="panel" Content="+ New" />
            <Button Name="BtnDuplicate" Classes="panel" Content="❐ Duplicate" />
            <Button Name="BtnDelete"    Classes="panel" Content="🗑 Delete" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,2">
            <Button Name="BtnRun"      Classes="panel" Content="▶ Run" Foreground="Green" />
            <Button Name="BtnRunAsync" Classes="panel" Content="⏩ Run Async" />
            <Button Name="BtnStop"     Classes="panel" Content="⏹ Stop" Foreground="Red" IsEnabled="False" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,2">
            <Button Name="BtnUndo" Classes="panel" Content="↩" ToolTip.Tip="Undo" />
            <Button Name="BtnRedo" Classes="panel" Content="↪" ToolTip.Tip="Redo" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,2">
            <Button Name="BtnComment"   Classes="panel" Content="Comment" />
            <Button Name="BtnUncomment" Classes="panel" Content="Uncomment" />
            <Button Name="BtnIndent"    Classes="panel" Content="Indent" />
            <Button Name="BtnUnindent"  Classes="panel" Content="Unindent" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2">
            <Button Name="BtnSnippet" Classes="panel" Content="Insert Snippet ▾" />
            <Button Name="BtnApiHelp" Classes="panel" Content="API Help" />
            <Button Name="BtnEditZed" Classes="panel" Content="Edit in Zed" ToolTip.Tip="Open a working copy in Zed. Save there, then Import from Zed to update the flowsheet script." />
            <Button Name="BtnImportZed" Classes="panel" Content="Import from Zed" ToolTip.Tip="Import the saved working copy. This does not run the script or save the flowsheet." />
          </StackPanel>
        </WrapPanel>

        <WrapPanel Name="ScriptOptions">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,2">
            <TextBlock Text="Name:" VerticalAlignment="Center" />
            <TextBox Name="TbTitle" VerticalAlignment="Center"
                     ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,2">
            <TextBlock Text="Interpreter:" VerticalAlignment="Center" />
            <ComboBox Name="CbInterpreter" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,2"
                      ToolTip.Tip="Syntax highlighting only. The interpreter selects the execution engine.">
            <TextBlock Text="Highlighting:" VerticalAlignment="Center" />
            <ComboBox Name="CbLanguage" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
            <TextBlock Text="Font:" VerticalAlignment="Center" />
            <ComboBox Name="CbFont" VerticalAlignment="Center" />
            <ComboBox Name="CbFontSize" VerticalAlignment="Center" ToolTip.Tip="Editor font size" />
          </StackPanel>
        </WrapPanel>

        <WrapPanel Name="EventOptions">
          <CheckBox Name="ChkLinked" Content="Run on event" VerticalAlignment="Center" Margin="0,0,12,2" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,2">
            <TextBlock Text="Object:" VerticalAlignment="Center" />
            <ComboBox Name="CbLinkedObject" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
            <TextBlock Text="Event:" VerticalAlignment="Center" />
            <ComboBox Name="CbLinkedEvent" VerticalAlignment="Center" />
          </StackPanel>
        </WrapPanel>

      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Name="StatusLabel" Text="Ready" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="120" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Padding="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Scripts" FontWeight="SemiBold" Margin="2,0,0,6" />
          <ListBox Name="ScriptList" BorderThickness="1" CornerRadius="4" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource SplitterBrush}"
                    Cursor="SizeWestEast" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="100" />
          <RowDefinition Height="5" />
          <RowDefinition Height="150" MinHeight="70" />
        </Grid.RowDefinitions>

        <ae:TextEditor Name="ScriptEditor"
                       Grid.Row="0"
                       Margin="0"
                       FontFamily="Hack,DejaVu Sans Mono,monospace"
                       FontSize="26"
                       Background="#0B0E14"
                       Foreground="#BFBDB6"
                       LineNumbersForeground="#6C7380"
                       ShowLineNumbers="True"
                       WordWrap="False" />

        <GridSplitter Grid.Row="1"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource SplitterBrush}" />

        <DockPanel Grid.Row="2" Margin="0">
          <Border DockPanel.Dock="Top" Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" />
              <Button Name="BtnClear" Classes="panel" Content="Clear" FontSize="{DynamicResource FontSizeSmall}" />
            </StackPanel>
          </Border>
          <TextBox Name="OutputBox"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   Height="NaN" MinHeight="0" Margin="0"
                   VerticalAlignment="Stretch"
                   VerticalContentAlignment="Top"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                   FontSize="{DynamicResource FontSizeNormal}"
                   Background="#0B0E14"
                   Foreground="#BFBDB6"
                   TextWrapping="Wrap" />
        </DockPanel>

      </Grid>

    </Grid>

  </DockPanel>

</UserControl>
